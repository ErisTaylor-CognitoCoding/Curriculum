    "steps": [
      {
        "title": "Introduction to Cumulative Frequency Graphs",
        "content": "Cumulative frequency graphs allow us to analyze data distributions by showing the running total of frequencies up to each data value. This helps to estimate medians, quartiles, and compare datasets easily."
      },
      {
        "title": "Multiple Choice Question: Interpreting Data from the Graph",
        "content": "If a cumulative frequency graph shows a total frequency of 100, and the cumulative frequency at 30 is 40, how many data values are less than or equal to 30?",
        "questions": [
          {
            "question": "Select the correct number of data values less than or equal to 30:",
            "options": ["30", "40", "60", "100"],
            "answer": "40",
            "explanation": "The cumulative frequency at 30 is 40, meaning 40 data values are less than or equal to 30."
          }
        ]
      },
      {
        "title": "Dropdown Cloze: Estimating Quartiles",
        "content": "To estimate the median from a cumulative frequency graph, find the point at (50% / total frequency) on the vertical axis, then read the corresponding data value on the horizontal axis.",
        "questions": [
          {
            "sentence": "The median corresponds to the cumulative frequency at ___% of the total frequency.",
            "dropdown": [
              "25",
              "50",
              "75",
              "100"
            ],
            "answer": "50"
          },
          {
            "sentence": "The lower quartile corresponds to the cumulative frequency at ___% of the total frequency.",
            "dropdown": [
              "25",
              "50",
              "75",
              "100"
            ],
            "answer": "25"
          },
          {
            "sentence": "The upper quartile corresponds to the cumulative frequency at ___% of the total frequency.",
            "dropdown": [
              "25",
              "50",
              "75",
              "100"
            ],
            "answer": "75"
          }
        ]
      },
      {
        "title": "Summary Cloze: Key Points",
        "content": "Cumulative frequency graphs are useful for estimating the ___(1)___ and quartiles of a dataset. They display the running total of frequencies so you can determine how many values are below a specific point. The ___(2)___ shows the middle value of the data and the ___(3)___ measures the spread between the lower and upper quartiles.",
        "questions": [
          {
            "sentence": "Fill in the blanks:",
            "dropdowns": [
              {
                "options": ["mean", "median", "mode"],
                "answer": "median"
              },
              {
                "options": ["graph shape", "median", "cumulative frequency"],
                "answer": "median"
              },
              {
                "options": ["interquartile range", "range", "mean"],
                "answer": "interquartile range"
              }
            ]
          }
        ]
      },
      {
        "title": "Practice Question: Reading a Cumulative Frequency Graph",
        "content": "Given a cumulative frequency graph with a total of 120 data points, the cumulative frequency at 45 is 30, at 60 is 65, and at 75 is 100:",
        "questions": [
          {
            "question": "How many data values are less than or equal to 60?",
            "answer": "65",
            "explanation": "The cumulative frequency at 60 shows 65 data values less than or equal to 60."
          },
          {
            "question": "Estimate the median value from the graph.",
            "answer": "Approximately 63",
            "explanation": "The median corresponds to 50% of 120 (which is 60). The cumulative frequency of 60 lies between 60 and 65, so the median is approximately between 60 and 63."
          },
          {
            "question": "Calculate the interquartile range (IQR) from the graph.",
            "answer": "Approximately 30",
            "explanation": "The lower quartile (25% of 120 = 30) is at about 45, the upper quartile (75% = 90) is at about 75, so IQR = 75 - 45 = 30."
          }
        ]
      }
    ]
